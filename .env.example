# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/videonotes

# Google Authentication
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# YouTube Data API v3 key.
# Google Cloud Console -> APIs & Services -> Enable "YouTube Data API v3" -> Credentials -> API key.
# The preferred source of a video's runtime: it is Google's own API, so it
# answers a cloud host normally, and a lookup costs 1 unit of a 10,000/day free
# quota. Without it a runtime is unknown until the transcript API reports it,
# so the free plan's duration cap cannot be checked before accepting a video.
YOUTUBE_API_KEY=

# Session JWTs issued by this API
JWT_SECRET_KEY=super_secret_key_change_me_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq API (note generation)
# https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA NIM API (alternative note generation backend)
# https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your_nvidia_nim_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Storage paths (local for development)
TRANSCRIPT_DIR=./transcripts
NOTES_DIR=./notes

# Free Plan Limits
FREE_DAILY_VIDEOS=2
FREE_DAILY_SHORT_VIDEOS=10
FREE_MAX_DURATION_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+

# Logging
LOG_LEVEL=INFO

# YouTube Transcripts API - the only source of transcripts.
# Create a key at https://youtubetranscripts.co/dashboard/api-keys
# The API serves a video's native captions where they exist and falls back to
# its own Whisper transcription where they do not, so this backend never
# downloads audio and needs no proxy, no yt-dlp and no ffmpeg.
TRANSCRIPT_API_KEY=yt_live_your_api_key
TRANSCRIPT_API_BASE_URL=https://api.youtubetranscripts.co
# Caption language: an ISO-639 code ("en", "hi") or "auto" for whatever the
# video ships with.
TRANSCRIPT_LANGUAGE=auto
# Translate the transcript into this language, or "none" to keep the original.
TRANSCRIPT_TRANSLATE_TO=none
# true skips the Whisper fallback. Native captions cost 1 credit per video,
# the Whisper fallback 1 credit per minute, so this caps the spend at the cost
# of failing on videos with no captions.
TRANSCRIPT_NATIVE_ONLY=false
# The API is asynchronous, so requests are polled. The timeout must cover a
# Whisper fallback on a long video.
TRANSCRIPT_POLL_INTERVAL_SECONDS=2
TRANSCRIPT_POLL_TIMEOUT_SECONDS=600
