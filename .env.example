# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/videonotes

# Google Authentication
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# YouTube Data API v3 key.
# Google Cloud Console -> APIs & Services -> Enable "YouTube Data API v3" -> Credentials -> API key.
# The preferred source of a video's runtime: it is Google's own API, so it
# answers a cloud host normally, and a lookup costs 1 unit of a 10,000/day free
# quota. Without it the runtime comes from the downloader's yt-dlp probe, which
# YouTube blocks from datacenter IPs.
YOUTUBE_API_KEY=

# Session JWTs issued by this API
JWT_SECRET_KEY=super_secret_key_change_me_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq API (transcription + note generation)
# https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA NIM API (alternative note generation backend)
# https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your_nvidia_nim_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Storage paths (local for development)
UPLOAD_DIR=./uploads
TRANSCRIPT_DIR=./transcripts
NOTES_DIR=./notes

# Free Plan Limits
FREE_DAILY_VIDEOS=2
FREE_DAILY_SHORT_VIDEOS=10
FREE_MAX_DURATION_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+

# Logging
LOG_LEVEL=INFO

# Downloader microservice (audio fallback when captions are unavailable).
# Local dev: run ./downloader on 8001. docker-compose overrides this with
# http://downloader:8001
DOWNLOADER_URL=http://localhost:8001

# Proxy for outbound YouTube traffic.
#
# YouTube answers datacenter IP ranges (GCP, AWS, ...) with "Sign in to confirm
# you're not a bot", so a deployed instance must egress through a residential
# proxy. Leave empty for local development.
#
# Either set a full proxy URL...
PROXY_URL=
# ...or Webshare credentials, which youtube-transcript-api uses to rotate exit
# nodes and retry when one of them is blocked. These take precedence.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
#
# The downloader service reads PROXY_URL from its own environment; set it there
# too. Internal backend -> downloader calls are never proxied.
